# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/matchmaking_db

# Security Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_here
JWT_EXPIRE=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API Keys (add as needed)
# EXTERNAL_API_KEY=your_external_api_key_here

# SMTP Configuration (for sending user credentials by email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=app_password_here
SMTP_FROM="MatchMaking Support <mailer@example.com>"

# Application URLs (for email templates)
APP_LOGIN_URL=https://app.matchmaking.com/login
APP_SUPPORT_EMAIL=support@matchmaking.com